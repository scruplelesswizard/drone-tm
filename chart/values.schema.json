{
  "$schema": "http://json-schema.org/schema#",
  "title": "drone-tm",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "storageClass": { "type": "string" }
      }
    },
    "existingSecret": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" }
      }
    },
    "extraEnvFrom": { "type": "array" },
    "env": { "type": "object" },

    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "tls": { "type": "array" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "backend": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "service": { "$ref": "#/$defs/service" },
        "resources": { "type": "object" },
        "startupProbe": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "autoscaling": { "$ref": "#/$defs/autoscaling" }
      }
    },

    "migrations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "annotations": { "type": "object" }
      }
    },

    "frontend": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "runtimeEnv": { "type": "object" },
        "mode": { "type": "string", "enum": ["bundleWithBackend", "cloudfront"] },
        "cloudfront": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "roleArn": { "type": "string" },
            "region": { "type": "string" },
            "s3Bucket": { "type": "string" },
            "version": { "type": "string" },
            "aliases": { "type": "array", "items": { "type": "string" } },
            "acmCertificateArn": { "type": "string" },
            "priceClass": {
              "type": "string",
              "enum": ["PriceClass_100", "PriceClass_200", "PriceClass_All"]
            },
            "awsCliImage": { "$ref": "#/$defs/image" }
          }
        }
      }
    },

    "worker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/$defs/image" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" },
        "startupProbe": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "autoscaling": { "$ref": "#/$defs/autoscaling" }
      }
    },

    "qgis": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/$defs/image" },
        "service": { "$ref": "#/$defs/service" },
        "env": { "type": "object" },
        "resources": { "type": "object" },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" }
      }
    },

    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "backend": { "$ref": "#/$defs/pdb" },
        "worker": { "$ref": "#/$defs/pdb" }
      }
    },

    "dragonfly": { "type": "object" },
    "postgresql": { "type": "object" },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },

    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  },

  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
